{
    "test_split": 0.1,
    "num_classes": 2,
    "batch_size": 16,
    "num_workers": 0,
    "n_augments": 2,
    "image_size": [512, 512],
    "optimizer_settings": {
        "learning_rate": 1e-5,
        "l2_decay_penalty": 1e-5
    },
    "n_epochs": 100,
    "pretrained_model": "nvidia/segformer-b4-finetuned-ade-512-512",
    "checkpoints": {
        "path": "/content/drive/MyDrive/SegmenterProject/checkpoint",
        "prefix": "model_lesion_segmentation",
        "patience": 5,
        "min_delta": 0.001
    },
    "loss_weights": {
        "weight_ce": 0.0,
        "weight_dice": 1.0,
        "weight_focal": 0.0,
        "weight_tversky": 0.0,
        "weight_iou": 0.0,
        "weight_boundary": 0.5
    },
    "scheduler": {
        "name": "CosineAnnealingLR",
        "T_max": 50
    },
    "datasets": {
        "hdf5": "data/all_images.hdf5",
        "image_paths": [
            "data/Classica/images",
            "data/Polyp Segmentation/train",
            "data/Polyp Segmentation/valid",
            "data/Kvasir-SEG/images"
        ],
        "mask_paths": [
            "data/Classica/masks",
            "data/Polyp Segmentation/train_masks",
            "data/Polyp Segmentation/valid_masks",
            "data/Kvasir-SEG/masks"
        ],
        "file_types": [
            "*.jpg",
            "*.png",
            "*.jpeg"
        ]
    }
}
