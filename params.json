{
    "test_split": 0.1,
    "num_classes": 2,
    "batch_size": 4,
    "num_workers": 0,
    "n_augments": 1,
    "image_size": [512, 512],
    "optimizer_settings": {
        "learning_rate": 1e-5,
        "l2_decay_penalty": 1e-3
    },
    "n_epochs": 100,
    "stopper_patience": 5,
    "pretrained_model": "nvidia/segformer-b4-finetuned-ade-512-512",
    "save_model_name": "best_dice_model.pth",
    "loss_weights": {
        "weight_ce": 0.5,
        "weight_dice": 0.7,
        "weight_focal": 0.1,
        "weight_tversky": 0.1,
        "weight_iou": 0.7
    },
    "scheduler": {
        "name": "CosineAnnealingLR",
        "T_max": 50
    }
}
