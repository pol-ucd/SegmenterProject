{
    "model": {
        "name": "SegformerForSemanticSegmentation",
        "params": {
          "num_labels": 2,
            "id2label": {
            "0": "Background", "1": "Lesion"
            }
        }
    },
    "run": {
        "test_split": 0.1,
        "num_classes": 11,
        "batch_size": 8,
        "num_workers": 16,
        "n_augments": 1,
        "image_size": [
            512,
            512
        ],
        "n_epochs": 100
    },
    "optimizer": {
            "learning_rate": 1e-4,
            "l2_decay_penalty": 1e-5
        },
    "pretrained_model": "nvidia/segformer-b4-finetuned-ade-512-512",
    "checkpoints": {
        "path": "../segmenter/checkpoint",
        "prefix": "model_lesion_segmentation",
        "patience": 7,
        "min_delta": 0.0001
    },
    "loss": {
        "function": "HybridLoss",
        "loss_params": {
            "ce": {
                "weight": 0.1
            },
            "dice": {
                "weight": 1.0
            },
            "focal": {
                "weight": 0.0
            },
            "tversky": {
                "weight": 0.0
            },
            "iou": {
                "weight": 0.0
            },
            "boundary_sdf": {
                "weight": 0.3,
                "dt_backend": "fastgeodis"
            },
            "soft_chamfer": {
                "weight": 0.3,
                "dt_backend": "fastgeodis"
            }
        }
    },
    "scheduler": {
        "name": "CosineAnnealingLR",
        "T_max": 50
    },
    "datasets": {
        "hdf5_dir": "../segmenter/data",
        "hdf5_files": ["all_data.h5"]
    }
}
