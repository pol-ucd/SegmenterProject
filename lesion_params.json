{
    "model": {
        "name": "segmenter.models.AugurSegformerSegmentation",
        "params": {
          "pretrained_model": "nvidia/segformer-b4-finetuned-ade-512-512",
          "num_labels": 2,
            "id2label": {
              "0": "Background",
              "1": "Lesion"
            }
        }
    },
    "loss_function": {
      "name": "segmenter.modules.HybridLoss",
      "params": {
            "ce": {
                "weight": 0.1
            },
            "dice": {
                "weight": 0.0
            },
            "focal": {
                "weight": 0.0,
                "alpha": 0.25,
                "gamma": 2.0
            },
            "tversky": {
                "weight": 1.0,
                "alpha": 0.7,
                "beta": 0.3
            },
            "iou": {
                "weight": 0.0
            },
            "boundary_sdf": {
                "weight": 0.05,
                "dt_backend": "kornia"
            },
            "soft_chamfer": {
                "weight": 0.05,
                "dt_backend": "kornia"
            }
        }
    },
    "run": {
        "max_gpu": 2,
        "test_split": 0.1,
        "num_classes": 2,
        "batch_size": 8,
        "num_workers": 16,
        "n_augments": 2,
        "image_size": [
            512,
            512
        ],
        "n_epochs": 200,
        "do_grad_scaling": true
    },
    "optimizer": {
            "name": "torch.optim.AdamW",
            "params": {
              "learning_rate": 1e-5,
              "l2_decay_penalty": 1e-5
            }
        },
    "pretrained_model": "nvidia/segformer-b4-finetuned-ade-512-512",
    "checkpoints": {
        "path": "../segmenter/checkpoint",
        "prefix": "tversky_clean_model_lesion_segmentation",
        "patience": 20,
        "min_delta": 0.00001
    },
    "scheduler": {
        "name": "CosineAnnealingLR",
        "T_max": 50
    },
    "datasets": {
        "hdf5_dir": "../segmenter/data",
        "hdf5_files": ["all_data.h5"]
    }
}
